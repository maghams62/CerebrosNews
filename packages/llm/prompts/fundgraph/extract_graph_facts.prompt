      "origin": "scraped|manual|synthetic"
    }
  ],
  "facts": {
    "deals": [
      {
        "factId": "string",
        "relationType": "INVESTED_IN",
        "fundName": "string",
        "companyName": "string",
        "roundStage": "allowed stage or Unknown",
        "announcedAt": "ISO-8601 string or empty",
        "amountMinM": 0.0,
        "amountMaxM": 0.0,
        "currency": "USD|EUR|GBP|INR|OTHER|UNKNOWN",
        "checkType": "lead|follow|unknown",
        "coInvestors": ["fund names"],
        "verified": true,
        "citationIds": ["citationId1"],
        "citationCount": 1,
        "confidence": 0.0
      }
    ],
    "fundMetadata": [
      {
        "factId": "string",
        "fundName": "string",
        "field": "sectors|stages|strategy|geography|partner",
        "value": "string",
        "verified": true,
