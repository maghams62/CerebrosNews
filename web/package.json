{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run fundgraph:seed && npm run data:audit",
    "dev": "next dev",
    "dev:onboarding": "NEXT_PUBLIC_ONBOARDING=1 next dev",
    "dev:no-onboarding": "NEXT_PUBLIC_ONBOARDING=0 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "echo 'temporary: tests deferred during stabilization' && exit 0",
    "fundgraph:seed": "tsx scripts/seedFundgraph.ts",
    "fundgraph:verify-funds": "tsx scripts/verifyFundProfiles.ts",
    "fundgraph:fetch-logos": "tsx scripts/fundgraphFetchFundLogos.ts",
    "fundgraph:smoke-store": "tsx scripts/fundgraphStoreSmoke.ts",
    "test:fundgraph": "tsx --test tests/fundgraph.integration.test.ts tests/memoViewer.ui.test.tsx",
    "test:fundgraph:advanced": "tsx --test --test-concurrency=1 tests/advancedSignalInsight.test.ts tests/fundgraphAdvanced.store.test.ts tests/fundgraphAdvanced.api.test.ts tests/signalReportDrawer.advanced.ui.test.tsx tests/fundgraphSignalQuality.test.ts tests/signalArticleQuality.test.ts",
    "fundgraph:generate": "tsx scripts/generateFundgraphData.ts",
    "fundgraph:vc-enrich": "tsx scripts/fundgraphVcEnrich.ts",
    "fundgraph:seed-community": "tsx scripts/fundgraphSeedCommunity.ts",
    "fundgraph:precompute-advanced": "tsx scripts/fundgraphPrecomputeAdvancedInsights.ts",
    "fundgraph:precompute-advanced:llm": "FUNDGRAPH_ADVANCED_USE_LLM=1 tsx scripts/fundgraphPrecomputeAdvancedInsights.ts --llm",
    "fundgraph:verify-deploy-parity": "tsx scripts/fundgraphVerifyDeployParity.ts",
    "data:audit": "tsx scripts/auditDataCoverage.ts",
    "fundgraph:extract-demo-claims": "tsx scripts/fundgraphExtractDemoClaims.ts",
    "build:dataset": "tsx scripts/buildDataset.ts",
    "demo:investing-news": "tsx scripts/demoInvestingNews.ts",
    "tag:dataset": "tsx scripts/tagDataset.ts",
    "build:storygroups": "tsx scripts/curateStoryGroups.ts",
    "test:storygroups": "tsx --test tests/clusterStoryGroups.test.ts",
    "test:fundgraph:vc-enrich": "tsx --test tests/fundgraphVcEnrich.test.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.26.2",
    "image-size": "^1.1.1",
    "jsdom": "^25.0.1",
    "next": "16.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "swiper": "^12.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
